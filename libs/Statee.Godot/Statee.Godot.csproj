<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Statee.Godot</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup Condition="'$(GodotTargetPlatform)' != 'web'">
    <PackageReference Include="ZLogger" Version="2.5.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Statee.Core\Statee.Core.csproj" />
  </ItemGroup>
  <!-- dn2cpp はホスト RID で publish するが GodotTargetPlatform=web は渡る(D-083) -->
  <ItemGroup Condition="'$(GodotTargetPlatform)' == 'web'">
    <Compile Remove="StateeLogging.Desktop.cs" />
    <Compile Remove="StandardCommands.Desktop.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(GodotTargetPlatform)' != 'web'">
    <Compile Remove="StateeLogging.Web.cs" />
  </ItemGroup>
</Project>
